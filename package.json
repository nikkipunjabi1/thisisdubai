{
  "name": "this-is-dubai",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --experimental-https",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "type-check": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "opti-login": "optimizely-cms-cli login",
    "opti-push": "optimizely-cms-cli config push optimizely.config.mjs",
    "_comment_envs": "Environment promotion: same code, different credentials. .env = primary, .env.<name> = another instance (gitignored). See docs/ENVIRONMENTS.md.",
    "opti-push:uat": "node --env-file=.env.uat ./node_modules/@optimizely/cms-cli/bin/run.js config push optimizely.config.mjs",
    "opti-login:uat": "node --env-file=.env.uat ./node_modules/@optimizely/cms-cli/bin/run.js login",
    "opti-snapshot": "optimizely-cms-cli config pull --json",
    "opti-snapshot:uat": "node --env-file=.env.uat ./node_modules/@optimizely/cms-cli/bin/run.js config pull --json",
    "seed:uat": "node --env-file=.env.uat scripts/seed.mjs",
    "teardown:env": "node scripts/teardown-env.mjs",
    "seed": "node --env-file=.env scripts/seed.mjs",
    "create-things-to-do": "node --env-file=.env scripts/create-things-to-do.mjs",
    "asset-manifest": "node scripts/asset-manifest.mjs",
    "cmp-folders": "node --env-file=.env scripts/cmp-folders.mjs",
    "create-section": "node --env-file=.env scripts/create-section.mjs",
    "migrate:experiences": "node --env-file=.env scripts/migrate-experiences.mjs",
    "attach-assets": "node --env-file=.env scripts/attach-assets.mjs",
    "source-images": "node --env-file=.env scripts/source-images.mjs",
    "seo:fill": "node --env-file=.env scripts/seo-fill.mjs",
    "publish:ar": "node --env-file=.env scripts/publish-ar.mjs",
    "align:ar-slugs": "node --env-file=.env scripts/align-ar-slugs.mjs"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/sdk-metrics": "^2.10.0",
    "@opentelemetry/sdk-node": "^0.221.0",
    "@opentelemetry/sdk-trace-node": "^2.7.1",
    "@optimizely/cms-sdk": "^2.2.0",
    "next": "^16.3.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@optimizely/cms-cli": "^2.2.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.2.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.3.0",
    "postcss": "^8.5.26",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}

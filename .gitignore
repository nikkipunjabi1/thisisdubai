# Dependencies
node_modules/
.pnp
.pnp.js
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Next.js / build output
.next/
out/
build/
dist/
*.tsbuildinfo
next-env.d.ts

# Generated GraphQL / codegen (regenerated locally)
gql/

# Environment & secrets — NEVER commit
.env
.env.*
!.env.example

# Vercel
.vercel

# Optimizely local
optimizely.local.*

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# OS / editor
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/*
!.vscode/extensions.json

# Claude Code local settings (machine-specific)
.claude/settings.local.json

# Testing / coverage
coverage/
.nyc_output/

# OpenTelemetry local output (from instrumentation.ts)
otel-output.log

# Local HTTPS certificates (next dev --experimental-https)
certificates/
*.pem

# Local CMS backups/snapshots — not project artifacts
# Local CMS backups/snapshots (e.g. pre-cleanup manifests) — not project artifacts
backups/

# Content inventory snapshots written by `npm run verify:content -- --out=<file>`.
# Generated, environment-specific, and only meaningful for the migration you are
# running right now. Keep them local.
*.inventory.json
dev.json
uat.json
prod.json
